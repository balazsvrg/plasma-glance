<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="showCpu" type="Bool">
            <label>Show CPU usage</label>
            <default>true</default>
        </entry>
        <entry name="showRam" type="Bool">
            <label>Show memory usage</label>
            <default>true</default>
        </entry>
        <entry name="showTemp" type="Bool">
            <label>Show CPU temperature</label>
            <default>true</default>
        </entry>
        <entry name="showFreq" type="Bool">
            <label>Show CPU frequency</label>
            <default>false</default>
        </entry>
        <entry name="showNet" type="Bool">
            <label>Show network speed</label>
            <default>false</default>
        </entry>
        <entry name="netBits" type="Bool">
            <label>Show network speed in bits per second instead of bytes</label>
            <default>false</default>
        </entry>
        <entry name="showBat" type="Bool">
            <label>Show battery</label>
            <default>false</default>
        </entry>
        <entry name="batteryCount" type="Int">
            <label>Number of batteries found (written by the widget, read by the settings pages)</label>
            <default>0</default>
        </entry>
        <entry name="showFan" type="Bool">
            <label>Show fan speed</label>
            <default>false</default>
        </entry>
        <entry name="fanAnimate" type="Bool">
            <label>Animate the fan icon</label>
            <default>true</default>
        </entry>
        <entry name="fanCount" type="Int">
            <label>Number of fans found (written by the widget, read by the settings pages)</label>
            <default>0</default>
        </entry>
        <entry name="maxLength" type="Int">
            <label>Maximum length of the panel strip in pixels along the panel (0 = no limit)</label>
            <default>0</default>
            <min>0</min>
            <max>5000</max>
        </entry>
        <entry name="useFahrenheit" type="Bool">
            <label>Show temperature in Fahrenheit</label>
            <default>false</default>
        </entry>
        <entry name="warnTemp" type="Int">
            <label>Warning temperature in degrees Celsius</label>
            <default>80</default>
            <min>30</min>
            <max>120</max>
        </entry>
        <entry name="refreshMs" type="Int">
            <label>Refresh interval in milliseconds</label>
            <default>1000</default>
            <min>250</min>
            <max>10000</max>
        </entry>
    </group>
    <group name="Popup">
        <entry name="popupCpu" type="Bool">
            <label>Popup: show CPU usage</label>
            <default>true</default>
        </entry>
        <entry name="popupMemory" type="Bool">
            <label>Popup: show memory</label>
            <default>true</default>
        </entry>
        <entry name="popupTempAvg" type="Bool">
            <label>Popup: show average CPU temperature</label>
            <default>true</default>
        </entry>
        <entry name="popupTempMax" type="Bool">
            <label>Popup: show hottest core temperature</label>
            <default>true</default>
        </entry>
        <entry name="popupFreq" type="Bool">
            <label>Popup: show CPU frequency</label>
            <default>false</default>
        </entry>
        <entry name="popupNet" type="Bool">
            <label>Popup: show network speed</label>
            <default>false</default>
        </entry>
        <entry name="popupBat" type="Bool">
            <label>Popup: show battery</label>
            <default>false</default>
        </entry>
        <entry name="batSeparate" type="Bool">
            <label>Popup: list each battery separately (only with several batteries)</label>
            <default>false</default>
        </entry>
        <entry name="popupFan" type="Bool">
            <label>Popup: show fan speed</label>
            <default>false</default>
        </entry>
        <entry name="popupCores" type="Bool">
            <label>Popup: show per-core temperatures</label>
            <default>true</default>
        </entry>
    </group>
    <group name="Graphs">
        <entry name="panelGraphStyle" type="Int">
            <label>Panel graph style: 1 behind text, 2 inline after text (an old 0 behaves like 1)</label>
            <default>1</default>
            <min>0</min>
            <max>2</max>
        </entry>
        <entry name="historySeconds" type="Int">
            <label>Graph history length in seconds</label>
            <default>60</default>
            <min>30</min>
            <max>300</max>
        </entry>
        <entry name="graphPanelCpu" type="Bool">
            <label>Panel: graph for CPU usage</label>
            <default>false</default>
        </entry>
        <entry name="graphPanelRam" type="Bool">
            <label>Panel: graph for memory</label>
            <default>false</default>
        </entry>
        <entry name="graphPanelTemp" type="Bool">
            <label>Panel: graph for CPU temperature</label>
            <default>false</default>
        </entry>
        <entry name="graphPanelFreq" type="Bool">
            <label>Panel: graph for CPU frequency</label>
            <default>false</default>
        </entry>
        <entry name="graphPanelNet" type="Bool">
            <label>Panel: graph for network speed</label>
            <default>false</default>
        </entry>
        <entry name="graphPanelBat" type="Bool">
            <label>Panel: graph for battery</label>
            <default>false</default>
        </entry>
        <entry name="graphPanelFan" type="Bool">
            <label>Panel: graph for fan speed</label>
            <default>false</default>
        </entry>
        <entry name="graphPopupCpu" type="Bool">
            <label>Popup: graph for CPU usage</label>
            <default>false</default>
        </entry>
        <entry name="graphPopupRam" type="Bool">
            <label>Popup: graph for memory</label>
            <default>false</default>
        </entry>
        <entry name="graphPopupTemp" type="Bool">
            <label>Popup: graph for CPU temperature</label>
            <default>false</default>
        </entry>
        <entry name="graphPopupFreq" type="Bool">
            <label>Popup: graph for CPU frequency</label>
            <default>false</default>
        </entry>
        <entry name="graphPopupNet" type="Bool">
            <label>Popup: graph for network speed</label>
            <default>false</default>
        </entry>
        <entry name="graphPopupBat" type="Bool">
            <label>Popup: graph for battery</label>
            <default>false</default>
        </entry>
        <entry name="graphPopupFan" type="Bool">
            <label>Popup: graph for fan speed</label>
            <default>false</default>
        </entry>
    </group>
</kcfg>
